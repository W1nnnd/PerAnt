#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if ! "$project_root/tool/prepare-linux-runtime" --verify-existing; then
  "$project_root/tool/prepare-linux-runtime"
fi
cd "$project_root/apps/perant"
"$project_root/tool/flutterw" build apk --debug --target-platform android-arm64 --split-per-abi

perant_version="$(awk '/^version:/ {print $2; exit}' pubspec.yaml)"
perant_version="${perant_version%%+*}"
perant_artifact_dir="$project_root/artifacts/apk"
perant_apk="PerAnt-$perant_version-debug-arm64.apk"
mkdir -p "$perant_artifact_dir"
cp build/app/outputs/flutter-apk/app-arm64-v8a-debug.apk "$perant_artifact_dir/$perant_apk"
cd "$perant_artifact_dir"
shasum -a 256 "$perant_apk" > "$perant_apk.sha256"
printf '\nAPK: %s/%s\n' "$perant_artifact_dir" "$perant_apk"
cat "$perant_apk.sha256"
